    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 세칙은 부천도시공사가 개발사업에 필요한 개발사업계획 수립, 단기 및 중장기 사업 발굴 등을 위하여 개발사업자문위원회를 설치하고, 그 구성과 운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기능",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(기능) 개발사업자문위원회(이하 “위원회”라 한다)는 다음 각 호의 기능을 수행한다.1. 부천도시공사(이하 “공사”라 한다) 개발업무규정 제2조제1호의 개발사업 계획에 관한 자문2. 중장기 개발사업의 계획 및 발굴에 관한 자문3. 단기 개발사업의 계획 및 발굴에 관한 자문4. 그 밖의 공사 개발사업을 위하여 필요한 사항으로써 사장이 필요하다고 인정하는 정책에 관한 자문",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구성",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(구성) ① 위원회는 위원장을 포함하여 13인 이내의 위원으로 구성한다.② 위원장은 사장으로 하고, 위원회를 대표하여 회의를 총괄한다.③ 내부위원은 공사 상임이사, 개발사업실장으로 하고, 외부위원은 도시개발 및 도시정비사업, 회계, 마케팅 분야의 학계, 공기업 등 실무경험자와 부천시 공무원 출신 관련 전문가 중에서 사장이 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임기",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(임기) 위원의 임기는 2년으로 하되 연임할 수 있다. 다만, 소속 임직원의 임기는 그 직위의 재임기간으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원회",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(위원회) ① 위원회는 위원장이 필요하다고 인정할 때에 소집한다.② 위원장이 부득이한 사유로 직무를 수행할 수 없을 때에는 위원회에 참석한 위원 중에서 호선하여 그 직무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "의견청취등",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(의견청취등) 위원회는 제2조의 기능을 수행함에 있어서 필요하다고 인정할 때에는 다음 각 호의 조치를 할 수 있다.1. 관계부서에 대한 설명 또는 자료제출 요청2. 관계직원의 출석 및 의견진술 요청3. 그 밖에 위원회가 필요로 하는 이해관계인, 참고인, 전문가 등의 의견개진요청",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "위원의 해촉",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(위원의 해촉) 사장은 위원이 다음 각 호의 어느 하나에 해당하는 사유가 발생하였을 때에는 해촉할 수 있다.1. 위원 본인이 사임을 원하는 경우2. 질병 또는 그 밖의 사유로 임무를 수행하기 어려울 때3. 품위손상 등 위원으로서 부적당하다고 인정되는 경우4. 그 밖에 위촉원인이 소멸된 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "간사",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(간사) 사장은 위원회의 원활한 사무를 처리하기 위하여 간사 1명을 두되, 간사는 위원회의 운영을 담당하는 부서의 팀장으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "비밀유지",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(비밀유지) 위원회에 참석한 위원 및 관계직원은 부의된 안건을 외부에 누설하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "수당 및 자문료 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(수당 및 자문료 등) 위원회에 출석한 직원 및 공사 관계공무원이 아닌 위원에게는 지방공기업 예산편성지침에 따라 수당 및 자문료 등을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:부천도시공사개발사업자문위원회운영시행세칙#JO0010"
      }
    ]
