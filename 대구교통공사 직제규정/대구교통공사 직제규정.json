    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총    칙",
        "chapter_path": "제1장  총    칙",
        "content": "제1조(목적)  이 규정은 대구도시철도공사(이하“공사”라 한다)의 직제에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총    칙",
        "chapter_path": "제1장  총    칙",
        "content": "제2조(적용범위)  공사의 직제에 관하여는 조례 및 정관이 정하는 것을  제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구성원",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제3조(구성원)  공사에 사장, 전무이사 및 직원을 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "사장",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제4조(사장)  사장은 공사를 대표하며 업무를 통할한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전무이사",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제5조(전무이사) ①전무이사는 경영전무이사와 기술전무이사 2인으로 하며 사장을 보좌한다.②경영전무이사는 기획경영처, 지원관리처 소관업무를 관장하고, 기술전무이사는 운영처, 기술처 소관업무를 관장한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "직무대행",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제6조(직무대행)  사장 유고시에는 경영전무이사, 기술전무이사 순으로 업무를 대행하고, 전무이사 유고시에는 직제 순위로 그 업무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "직원",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제7조(직원)  직원의 직급은 1급에서 9급으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "고문, 전문위원 등",
        "chapter": "제2장  구 성 원",
        "chapter_path": "제2장  구 성 원",
        "content": "제8조(고문, 전문위원 등)  ①공사는 필요에 따라 고문, 전문위원, 자문위원 등을 위촉할 수 있다.②공사는 특수한 기술 또는 자격과 경험을 필요로 하는 분야에는 계약직을 둘 수 있으며 계약직에 관한 사항은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "기구",
        "chapter": "제3장  조   직",
        "chapter_path": "제3장  조   직",
        "content": "제9조(기구)  ①공사에 본사 및 현업기관을 둔다.②본사에는 기획경영처, 지원관리처, 운영처, 기술처, 안전관리실, 감사실을 두며, 처·실에 부를 둔다.<개정  ’11. 5. 19, ’12. 7. 17>③현업에는 사장직속으로 신사업개발단, 지원관리처 산하에 교육원, 1고객센터, 2고객센터, 기술전무이사 직속으로 종합관제소, 운영처 산하에 차량기지사업소 3개소, 기술처 산하에 시설사업소, 전기기계사업소, 신호통신전자사업소를 둔다. <개정 ’09. 12. 23, ’11. 5. 19, ’12. 7. 17>④공사의 기구는 별표 1과 같다.⑤공사는 필요에 따라 처·실 및 현업기관에 팀을 둘 수 있으며, 이에 관한 사항은 내규로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "보직",
        "chapter": "제3장  조   직",
        "chapter_path": "제3장  조   직",
        "content": "제10조(보직)  제9조 제2항과 제3항의 처·실장과 단·원·센터·소장 및 부장은 1급부터 3급까지의 직원으로 보하고, 동조 제5항의 팀장은 2급 또는 3급 직원으로 보한다. <개정 ’11. 5. 19>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "정원",
        "chapter": "제3장  조   직",
        "chapter_path": "제3장  조   직",
        "content": "제11조(정원)  공사의 직급별 정원은 별표 2와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "직무분장",
        "chapter": "제3장  조   직",
        "chapter_path": "제3장  조   직",
        "content": "제12조(직무분장)  공사 직무분장은 별표 3과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "위원회등",
        "chapter": "제4장  보   칙",
        "chapter_path": "제4장  보   칙",
        "content": "제13조(위원회등)  ①공사는 업무상 필요하다고 인정하는 때에는 위원회 및 전문연구기구를 설치 운영할 수 있다.②제1항의 위원회 및 전문연구기구에 관한 필요한 사항은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "한시기구",
        "chapter": "제4장  보   칙",
        "chapter_path": "제4장  보   칙",
        "content": "제14조(한시기구)  한시적인 특정업무 수행을 위하여 필요한 경우에는 사장이 하는 바에 따라 정원 범위 내에서 임시조직을 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사직제규정#JO0014"
      },
      {
