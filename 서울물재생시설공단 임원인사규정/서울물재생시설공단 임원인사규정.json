      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총칙",
        "chapter_path": "제1장  총칙",
        "content": "제2조(적용범위) 공단의 임원(비상임이사는 제외한다. 이하 같다)에 대한 인사관리는 다른 법령과 정관 또는 공단의 규정에서 특별히 정한 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:서울물재생시설공단임원인사규정#JO0002"
