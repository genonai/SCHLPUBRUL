    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총   칙",
        "chapter_path": "제1장  총   칙",
        "content": "제1조(목적)  이 규정은 대구광역시지하철공사(이하 “공사”라 한다) 임원의 복무 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총   칙",
        "chapter_path": "제1장  총   칙",
        "content": "제2조(적용범위)  공사의 임원(비상임이사 및 비상임감사는 제외한다. 이하 같다)에 대한 복무 등에 관하여는 다른 법령과 정관 또는 공사에서 특별히 정한 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "용어의 정의",
        "chapter": "제1장  총   칙",
        "chapter_path": "제1장  총   칙",
        "content": "제3조(용어의 정의)  이 규정에서 “임원”이라 함은 공사의 사장(이하 “사장”이라 한다)을 포함한 이사와 감사를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "성실 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제4조(성실 의무)  ①임원은 법령과 정관 및 공사의 규정을 준수하여야 하며, 그 직무를 성실히 수행하여야 한다.②임원은 공사의 명예를 훼손하거나 재산상의 손해를 입히는 행위를 하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "복종의 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제5조(복종의 의무)  임원은 그 직무를 수행함에 있어 사장 또는 공사업무 감독기관의 장의 직무상 명령에 복종하여야 한다. 다만, 이에 대한 의견은 진술할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "직장이탈금지 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제6조(직장이탈금지 의무)  임원은 임·면권자의 허가 또는 정당한 이유없이 직장을 이탈하지 못한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "친절·공정의 업무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제7조(친절·공정의 업무)  임원은 그 직무를 수행함에 있어 친절·공정하게 신속히 업무를 처리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "비밀엄수의 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제8조(비밀엄수의 의무)  임원은 재직중은 물론 퇴직 후에도 직무상 지득한 비밀을 엄수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "청렴의 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제9조(청렴의 의무)  ①임원은 직무와 관련하여 직접 또는 간접을 불문하고 사례, 증여 또는 향응을 수수할 수 없다.②임원은 직무상의 관계 여하를 불문하고 임·면권자나 업무상 감독자에게 증여할 수 없으며 그 소속 직원으로부터 증여를 받아서도 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "품위유지의 의무",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제10조(품위유지의 의무)  임원은 그 품위를 손상하는 행위를 하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "영리업무 및 겸직금지",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제11조(영리업무 및 겸직금지)  ①임원은 직무 이외에 영리를 목적으로 하는 업무에 종사하여서는 아니 된다.②임원은 대구광역시장의 허가 없이는 다른 직무를 겸할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "근무시간 등",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제12조(근무시간 등)  임원의 근무시간 및 출장 등에 대하여는 공사의 복무규정을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "공사에 대한 책임",
        "chapter": "제2장  복   무",
        "chapter_path": "제2장  복   무",
        "content": "제13조(공사에 대한 책임)  임원이 법령 및 정관에 위반한 행위를 하거나 그 임무를 태만하여 공사에 손해를 끼친 때에는 그 임원은 손해를 배상할 책임이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "포상",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제14조(포상)  사장은 임원이 헌신적인 노력으로 공사의 경영개선에 크게 기여하거나 대외적으로 공사의 명예를 높이 선양하는 등 공사의 경영발전에 공로가 뚜렷한 경우 포상할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0014"
      },
      {
        "article_no": "제14조의2",
        "article_title": "경영성과에 따른 연·해임",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제14조의2(경영성과에 따른 연·해임)  사장은 경영성과에 따라 임기만료에도 불구하고 연임되거나 임기 중이라도 해임될 수 있으며, 그 기준은 별표 2와 같다.[본조신설 ’07. 5. 3]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0014_02"
      },
      {
        "article_no": "제15조",
        "article_title": "문책",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제15조(문책)  임원이 다음 각호의 1에 해당하는 경우에는 문책한다.1. 법령과 정관 또는 공사의 규정에 위반한 때2. 직무상 의무를 위반하거나 태만히 하였을 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "문책의 종류",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제16조(문책의 종류)  임원에 대한 문책은 해임, 경고 및 주의로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0016"
      },
      {
        "article_no": "제17조",
        "article_title": "문책의 효력",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제17조(문책의 효력)  ①해임은 임원의 신분을 해제하며, 이 경우 보수규정에 의거 산출된 퇴직금의 2분의 1을 감하여 지급한다.②경고는 1월 이상 6월 이하의 기간 동안 보수규정에 의한 봉급의 10분의 1을 감하여 지급하며, 당해 임기중 2회 이상 경고를 받은 경우에는 그 연임을 제한하고, 3회 이상 경고시에는 해임한다.③주의는 전과에 대하여 훈계하고 회개하게 하며, 주의 3회시에는 경고 1회로 간주한다.④문책은 당해 임기만료로 효력을 상실한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0017"
      },
      {
        "article_no": "제18조",
        "article_title": "문책의 절차",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제18조(문책의 절차)  ①임원의 문책은 임·면권자가 행한다. 다만, 필요할 경우에는 이사회에 안건으로 부의할 수 있다.②이사회에서 심의할 경우에는 당해 임원은 이사회에 참여할 수 없다. 다만, 이사회에 출석하여 진술은 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0018"
      },
      {
        "article_no": "제19조",
        "article_title": "문책양정기준",
        "chapter": "제3장  상   벌",
        "chapter_path": "제3장  상   벌",
        "content": "제19조(문책양정기준)  임원의 문책양정기준은 별표와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0019"
      },
      {
        "article_no": "제20조",
        "article_title": "시행내규",
        "chapter": "제4장  보   칙",
        "chapter_path": "제4장  보   칙",
        "content": "제20조(시행내규)  이 규정의 시행에 관하여 필요한 사항은 내규로 정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:대구교통공사임원인사규정#JO0020"
      }
    ]
  },
