  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규칙은 한국보건복지인재원이 이사회의 운영에 관하여 필요한 사항을 정함을 목적으로 한다. <개정 2022. 1. 28.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 한국보건복지인재원(이하 \"인재원\"이라 한다) 이사회의 구성과 운영에 관하여 관계 법령이나 「정관」 에서 정한 것을 제외하고는 이 규정에 따른다. <개정 2022. 1. 28.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "부의절차",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(부의절차) ① 이사회에 부의안건을 상정하고자 할 때에 소관 부서장은 원장의 재가를 받은 후 별지 제3호서식에 의한 의안을 작성하여 부의 안건의 상정을 이사회 주관부서에 요청하여야 한다.② 이사회 주관부서는 이사회에 부의해야 할 사항에 대하여 사전에 원장의 승인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "관계인의 의견진술",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(관계인의 의견진술) 의장이 필요하다고 인정한 때에는 상정된 의안의 관계인에게 이사회에 출석하여 의견을 진술하게 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "회의록 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(회의록 등) 원장은 이사회 회의록 등 이사회의 운영에 관한 서식은 별지 서식에 의한다.1. 소집통보서는 별지 서식1호에 의한다.2. 위임장은 별지 서식2호에 의한다.3. 의결주문서는 별지 서식3호에 의한다.4. 회의록은 별지 서식4호에 의한다.5. 서면결의서는 별지 서식5호에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "간사",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(간사) 이사회의 사무를 처리하기 위하여 간사 1인을 두되, 간사는 직제규정에 의하여 이사회의 운영에 관한 업무를 담당하는 본부의 장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수당",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(수당) 이사회에 참석한 이사에게는 업무수행에 필요한 실비를 예산의 범위 내에서 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "근로자의 참관",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(근로자의 참관) 원장은 근로자를 대표하는 조직에서 희망하는 경우 근로자 1인에 대해 이사회에 참관하게 할 수 있다.[본조신설 2020. 8. 18.][종전 제8조는 제9조로 이동 <2020. 8. 18.>]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "보칙",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(보칙) 이 규칙에 명시되지 아니한 사항은 이사회의 의결을 거쳐 정할 수 있다.[제8조에서 이동 <2020. 8. 18.>]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국보건복지인재원)이사회운영규칙#JO0009"
      }
    ]
  },
