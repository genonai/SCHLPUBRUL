      {
        "article_no": "제7조",
        "article_title": "이중포상 금지",
        "chapter": "제2장 포상",
        "chapter_path": "제2장 포상",
        "content": "제7조(이중포상 금지) 포상은 동일한 공적에 대하여 이중으로 이를 행하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:경상국립대학교학생상벌규정#JO0007"
