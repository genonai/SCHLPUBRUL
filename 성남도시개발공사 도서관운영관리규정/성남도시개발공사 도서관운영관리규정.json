      },
      {
        "article_no": "제11조",
        "article_title": "실비변상",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(실비변상) 제7조 및 제8조에 따른 위원회 위원이 회의에 출석한 경우 예산의 범위 내에서 참석수당 등을 지급할 수 있다.",
        "enforcement_date": "",
