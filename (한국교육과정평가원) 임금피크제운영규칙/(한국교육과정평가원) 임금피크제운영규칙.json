    "articles": [
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 규칙은 모든 직원에 대하여 적용한다. 다만, 비정규직원에 관한 규칙 및 계약직원에 관한 규칙에 의거하여 채용된 직원은 제외한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:임금피크제운영규칙(한국교육과정평가원)#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임금피크제의 적용시점",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(임금피크제의 적용시점) 임금피크제는 대상 직원의 정년퇴직예정일 2년 전부터 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:임금피크제운영규칙(한국교육과정평가원)#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임금의 조정",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(임금의 조정) 임금피크제 대상 직원의 연봉은 연봉기준액산정치침에 의거하여 산정된 총연봉에 다음의 적용 연차별 임금지급률을 곱한 금액으로 한다.적용 연차1년차2년차지급률95%70%",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:임금피크제운영규칙(한국교육과정평가원)#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "퇴직금 중간정산",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(퇴직금 중간정산) 임금피크제 대상 직원에 대하여는 임금의 조정이 시작되는 때부터 매년 퇴직금 중간정산을 실시하여 임금 감액에 따른 부작용이 발생하지 않도록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:임금피크제운영규칙(한국교육과정평가원)#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "복무 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(복무 등) 임금피크제 대상 직원의 복무, 성과평가, 복리후생 등에 관한 사항 및 기타 본 규칙 및 다른 규정에서 별도로 정하지 아니한 사항에 대해서는 임금피크제 적용을 받지 아니하는 직원과 동일하다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:임금피크제운영규칙(한국교육과정평가원)#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "퇴직지원 프로그램",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(퇴직지원 프로그램) 임금피크제가 적용되는 직원에 대하여는 퇴직 후의 인생설계, 여가, 건강 등 노후 문제에 대한 교육 및 컨설팅 등 퇴직지원 프로그램을 별도로 제공할 수 있다.",
        "enforcement_date": "",
